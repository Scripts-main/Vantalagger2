local function updateUIScale()
    if not mainFrame then return end
    
    local baseSizeX = 200
    local baseSizeY = 120
    
    local scaledSizeX = currentSize.X.Offset
    local scaledSizeY = currentSize.Y.Offset
    
    local sx = scaledSizeX / baseSizeX
    local sy = scaledSizeY / baseSizeY
    
    if titleLabel then
        titleLabel.TextSize = math.clamp(math.floor(11 * math.min(sx, sy)), 8, 16)
        titleLabel.Size = UDim2.new(1, -190 * sx, 0, 26 * sy)
        titleLabel.Position = UDim2.new(0, 12 * sx, 0, 0)
    end
    
    if textEnable then
        textEnable.TextSize = math.clamp(math.floor(9 * math.min(sx, sy)), 6, 14)
        textEnable.Position = UDim2.new(0, 10 * sx, 0, 32 * sy)
        textEnable.Size = UDim2.new(0, 38 * sx, 0, 16 * sy)
    end
    
    if textLagger then
        textLagger.TextSize = math.clamp(math.floor(9 * math.min(sx, sy)), 6, 14)
        textLagger.Position = UDim2.new(0, 50 * sx, 0, 32 * sy)
        textLagger.Size = UDim2.new(0, 42 * sx, 0, 16 * sy)
    end
    
    if toggleContainer then
        if windowMinimized then
            toggleContainer.Position = UDim2.new(1, -112 * sx, 0, 5 * sy)
            toggleContainer.Size = UDim2.new(0, 38 * sx, 0, 16 * sy)
        else
            toggleContainer.Position = UDim2.new(1, -60 * sx, 0, 30 * sy)
            toggleContainer.Size = UDim2.new(0, 50 * sx, 0, 20 * sy)
        end
    end
    
    if toggleBall then
        if windowMinimized then
            toggleBall.Size = UDim2.new(0, 14 * sx, 0, 14 * sy)
            toggleBall.Position = laggerActive and UDim2.new(1, -14 * sx, 0.5, -7 * sy) or UDim2.new(0, 2 * sx, 0.5, -7 * sy)
        else
            toggleBall.Size = UDim2.new(0, 18 * sx, 0, 18 * sy)
            toggleBall.Position = laggerActive and UDim2.new(1, -18 * sx, 0.5, -9 * sy) or UDim2.new(0, 3 * sx, 0.5, -9 * sy)
        end
    end
    
    if toggleClick then
        toggleClick.TextSize = math.clamp(math.floor((windowMinimized and 7 or 9) * math.min(sx, sy)), 5, 14)
    end
    
    if lockToggleContainer then
        lockToggleContainer.Position = UDim2.new(1, -60 * sx, 0, 7 * sy)
        lockToggleContainer.Size = UDim2.new(0, 50 * sx, 0, 16 * sy)
    end
    
    if lockToggleBall then
        lockToggleBall.Size = UDim2.new(0, 14 * sx, 0, 14 * sy)
        lockToggleBall.Position = windowLocked and UDim2.new(1, -14 * sx, 0.5, -7 * sy) or UDim2.new(0, 2 * sx, 0.5, -7 * sy)
    end
    
    if lockToggleClick then
        lockToggleClick.TextSize = math.clamp(math.floor(7 * math.min(sx, sy)), 5, 12)
    end
    
    if powerIndicator then
        powerIndicator.TextSize = math.clamp(math.floor(8 * math.min(sx, sy)), 5, 13)
        powerIndicator.Position = UDim2.new(0, 10 * sx, 0, 60 * sy)
    end
    
    if btnLow then
        local btnW = math.floor(42 * sx)
        local btnH = math.floor(22 * sy)
        local spacing = math.floor(5 * sx)
        local leftMargin = math.floor(9 * sx)
        local btnY = math.floor(84 * sy)
        
        btnLow.Size = UDim2.new(0, btnW, 0, btnH)
        btnLow.Position = UDim2.new(0, leftMargin, 0, btnY)
        btnLow.TextSize = math.clamp(math.floor(9 * math.min(sx, sy)), 6, 14)
        
        btnMid.Size = UDim2.new(0, btnW, 0, btnH)
        btnMid.Position = UDim2.new(0, leftMargin + btnW + spacing, 0, btnY)
        btnMid.TextSize = math.clamp(math.floor(9 * math.min(sx, sy)), 6, 14)
        
        btnHigh.Size = UDim2.new(0, btnW, 0, btnH)
        btnHigh.Position = UDim2.new(0, leftMargin + (btnW + spacing) * 2, 0, btnY)
        btnHigh.TextSize = math.clamp(math.floor(9 * math.min(sx, sy)), 6, 14)
        
        btnUltra.Size = UDim2.new(0, btnW + math.floor(4 * sx), 0, btnH)
        btnUltra.Position = UDim2.new(0, leftMargin + (btnW + spacing) * 3, 0, btnY)
        btnUltra.TextSize = math.clamp(math.floor(8 * math.min(sx, sy)), 5, 13)
    end
    
    if btnMinimize then
        btnMinimize.Position = UDim2.new(1, -138 * sx, 0, 5 * sy)
        btnMinimize.Size = UDim2.new(0, 18 * sx, 0, 16 * sy)
        btnMinimize.TextSize = math.clamp(math.floor(10 * math.min(sx, sy)), 7, 16)
    end

    if btnPlus then
        btnPlus.Position = UDim2.new(1, -118 * sx, 0, 5 * sy)
        btnPlus.Size = UDim2.new(0, 18 * sx, 0, 16 * sy)
        btnPlus.TextSize = math.clamp(math.floor(10 * math.min(sx, sy)), 7, 16)
    end
    
    if btnMinus then
        btnMinus.Position = UDim2.new(1, -98 * sx, 0, 5 * sy)
        btnMinus.Size = UDim2.new(0, 18 * sx, 0, 16 * sy)
        btnMinus.TextSize = math.clamp(math.floor(10 * math.min(sx, sy)), 7, 16)
    end
    
    if statusDot then
        statusDot.Size = UDim2.new(0, math.clamp(math.floor(5 * math.min(sx, sy)), 3, 8), 0, math.clamp(math.floor(5 * math.min(sx, sy)), 3, 8))
        statusDot.Position = UDim2.new(0, 2 * sx, 0, 10 * sy)
    end
end

local function toggleMinimizeWindow()
    windowMinimized = not windowMinimized
    
    local sx = currentSize.X.Offset / 200
    local sy = currentSize.Y.Offset / 120
    local minimizedHeight = math.floor(26 * sy)
    
    local targetSize = windowMinimized and UDim2.new(0, currentSize.X.Offset, 0, minimizedHeight) or currentSize
    
    btnMinimize.Text = windowMinimized and "□" or "_"
    
    -- Animar resize de la ventana
    TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = targetSize
    }):Play()
    
    -- Ocultar otros elementos pero conservar el toggleVisible
    local elementsToHide = {
        textEnable, textLagger, powerIndicator,
        btnLow, btnMid, btnHigh, btnUltra
    }
    
    for _, elem in ipairs(elementsToHide) do
        if elem then elem.Visible = not windowMinimized end
    end

    -- Re-escalar y acomodar el toggle
    updateUIScale()
    SaveConfig()
end

